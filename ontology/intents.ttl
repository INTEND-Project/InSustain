@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix intendproject: <http://intendproject.eu/> .
@prefix log:   <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix set:   <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix quan:  <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .


##### BUSINESS LEVEL INTENT ######
# inChat transformed the intent expressed in natural languague (and dialogue with user)
# to the following intent expressed according to the TM Forum intent ontology v3.6.0
# Highlights:
#   - less than 10ms 5G Network latency and more than 300 mbit/s bandwidth is needed
#   - less than 10ms compute latency is needed
#   - all of this is needed in a specific region and for Augmented Reality User Equipment
# This business level intent will be sent to inSwitch (the target of the intent) and
# stored in the knowledge graph

intendproject:Bs_Intent a icm:Intent ;
  log:allOf ( intendproject:DE1 intendproject:RE1 intendproject:EE1) ;
.

intendproject:DE1 a icm:DeliveryExpectation ;
  icm:target intendproject:inSwitch ;
  dct:description "Deliver low latency and stable bandwidth sufficient for AR goggles connected to Telenor 5G network "@en ;
  log:allOf ( intendproject:DC1 )
.

intendproject:DC1 a icm:Condition ;
    set:forAll ( _:X
        [ icm:valuesOfTargetProperty ( intendproject:TelenorEdgeComputeLatency ) ]
        quan:smaller ( _:X [ rdf:value "10"^^xsd:decimal ;
        quan:unit "ms"
        ] )
    )
.

intendproject:EE1 a icm:PropertyExpectation ;
  icm:target intendproject:inSwitch ;
  dct:description " The solution must align with the company green targets"@en ;
    log:allOf ( intendproject:EC1 )
.

intendproject:EC1 a icm:Condition ;
    set:forAll ( _:X
        [ icm:valuesOfTargetProperty ( intendproject:TelenorEdgeEnergyEfficiencyScore ) ]
        quan:smaller ( _:X [ rdf:value "95"^^xsd:decimal ;
        quan:unit "%"
        ] )
    )
.

intendproject:RE1 a icm:ReportingExpectation ;
  icm:target intendproject:inSwitch ;
  dct:description "Report if expectation is met with reports including metrics related to expectations"@en ;
.

#####SERVICE LEVEL INTENT#################3
# This service level intent will be sent to IDO (formerly inOrch) and
# will also be stored in the knowledge graph (could be used by inCoord for coordination)

intendproject:Se_Intent a icm:Intent ;
  log:allOf ( intendproject:DE2 intendproject:RE2 intendproject:EE2) ;
.

# inSwitch decided that it is necessary to deploy the compute to an Edge datacenter
# in order to meet the compute latency needed

intendproject:DE2 a icm:DeliveryExpectation ;
  icm:target intendproject:IDO ;
  dct:description "Ensure the AR application is deployed to a local Edge Data Center with compute latency below 10ms."@en ;
  log:allOf ( intendproject:DC2 ) ;
.

intendproject:DC2 a icm:Condition ;
  set:forAll ( _:X
    [ icm:valuesOfTargetProperty ( intendproject:ComputeLatency ) ]
    quan:smaller ( _:X [ rdf:value "10"^^xsd:decimal ;
      quan:unit "ms"
    ] )
  ) ;
.

# This translates the business KPI into a concrete service-level objective for power.
intendproject:EE2 a icm:PropertyExpectation ;
  dct:description "The total power consumption for this AR service must not exceed 200 Watts."@en ;
  icm:target intendproject:IDO ;
  log:allOf ( intendproject:EC2 ) 
.

intendproject:EC2 a icm:Condition ;
  set:forAll ( _:X
    [ icm:valuesOfTargetProperty ( intendproject:PowerConsumption ) ]
    quan:smaller ( _:X [ rdf:value "200"^^xsd:decimal ;
      quan:unit "W"
    ] )
  ) ;
.

intendproject:RE2 a icm:ReportingExpectation ;
  icm:target intendproject:EdgeDataCenter ;
  dct:description "Report if expectation is met with reports including metrics related to expectations."@en ;
.

#####Resource level intent################################33#######
# GOAL: Define the specific resource needed to fulfill the service.
# =================================================================
intendproject:I3 a icm:Intent ;
  log:allOf ( intendproject:DE3 intendproject:RE3) ;
.

# IDO at the REsource layer has decided that the necessary action is to deploy a pod
# on the Edge Data Center in order to meet the compute latency needed
intendproject:DE3 a icm:DeliveryExpectation ;
  icm:target intendproject:K8sCluster ;
  dct:description "Deploy two pods on the Edge Data Center with 2 CPUs and 8GB RAM and each one less tah 3kw of power."@en ;
  log:allOf ( intendproject:CC3 intendproject:MC3 intendproject:EC3) 
.

intendproject:CC3 a icm:Condition ;
  set:forAll ( _:X
    [ icm:valuesOfTargetProperty ( intendproject:CPU ) ]
    quan:smaller ( _:X [ rdf:value "2"^^xsd:decimal ;
      quan:unit "CPU"
    ] )
  ) ;
.

intendproject:MC3 a icm:Condition ;
  set:forAll ( _:X
    [ icm:valuesOfTargetProperty ( intendproject:Memory ) ]
    quan:smaller ( _:X [ rdf:value "8"^^xsd:decimal ;
      quan:unit "GB"
    ] )
  ) ;
.

intendproject:EC3 a icm:Condition ;
  set:forAll ( _:X
    [ icm:valuesOfTargetProperty ( intendproject:PowerConsumption ) ]
    quan:smaller ( _:X [ rdf:value "3"^^xsd:decimal ;
      quan:unit "kw"
    ] )
  ) ;
.

intendproject:RE3 a icm:ReportingExpectation ;
  icm:target intendproject:K8sCluster ;
  dct:description "Report if expectation is met with reports including metrics related to expectations."@en ;
.
@prefix instn: <http://example.org/instn#> .
@prefix prometheus: <http://example.org/prometheus#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

################################################################
# Classes
################################################################

instn:TargetApplication a owl:Class ;
    rdfs:label "Target Application" ;
    rdfs:comment "An application being monitored for energy metrics." .

instn:AnalyticsProvider a owl:Class ;
    rdfs:label "Analytics Provider" ;
    rdfs:comment "An entity or system that receives energy metrics and performs analysis on behalf of a stakeholder." .

instn:ServiceEndpoint a owl:Class ;
    rdfs:label "Service Endpoint" ;
    rdfs:comment "An individual deployable unit (e.g., a container or pod) of the monitored application." .

instn:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "A logical component or module of an application." .

prometheus:PrometheusMetric a owl:Class ;
    rdfs:label "Prometheus Metric" ;
    rdfs:comment "A metric exposed by the system, e.g., energy consumption or CPU usage." .

instn:Resource a owl:Class ;
    rdfs:label "Resource" ;
    rdfs:comment "The resource for which a metric is calculated, e.g., CPU or memory." .

instn:AggregationLevel a owl:Class ;
    rdfs:label "Aggregation Level" ;
    rdfs:comment "The level of aggregation applied to the metrics, e.g., service-level, end-to-end." .

instn:K8sType a owl:Class ;
    rdfs:label "Kubernetes Type" ;
    rdfs:comment "Specifies the type of endpoint (e.g., Pod, Service)." .

################################################################
# Individuals
################################################################

instn:EnergyMetric a instn:prometheusMetric ;
    rdfs:label "Energy Metric" ;
    rdfs:comment "A Prometheus metric that reports energy consumption (e.g., joules, watts)." .

instn:ApplicationMetric a instn:prometheusMetric ;
    rdfs:label "Application Metric" ;
    rdfs:comment "A Prometheus metric that reports application-level KPIs (e.g., request latency)." .

instn:ServiceLevel a instn:AggregationLevel ;
    rdfs:label "Service Level" .

instn:NamespaceLevel a instn:AggregationLevel ;
    rdfs:label "Namespace Level" .

instn:PodLevel a instn:AggregationLevel ;
    rdfs:label "Pod Level" .

instn:EndToEnd a instn:AggregationLevel ;
    rdfs:label "End-to-End Level" .

instn:Pod a instn:K8sType ;
    rdfs:label "Pod Type" .

instn:Service a instn:K8sType ;
    rdfs:label "Kubernetes Service" .

instn:Namespace a instn:K8sType ;
    rdfs:label "Kubernetes Namespace" .

instn:Container a instn:K8sType ;
    rdfs:label "Kubernetes Container" .

instn:CPU a instn:Resource ;
    rdfs:label "CPU" .

instn:Memory a instn:Resource ;
    rdfs:label "Memory" .

instn:GPU a instn:Resource ;
    rdfs:label "GPU" .

################################################################
# Properties
################################################################

instn:hasEndpoint a owl:ObjectProperty ;
    rdfs:domain instn:Service ;
    rdfs:range instn:ServiceEndpoint ;
    rdfs:label "has endpoint" ;
    rdfs:comment "Links the application to its service endpoints." ;
    owl:minCardinality 1 .  # A service should have at least one endpoint

instn:analyzes a owl:ObjectProperty ;
    rdfs:domain instn:AnalyticsProvider ;
    rdfs:range instn:TargetApplication ;
    rdfs:label "analyzes Application" ;
    rdfs:comment "The application being monitored for energy metrics." ;
    owl:minCardinality 1 ;
    owl:maxCardinality 1 .

instn:monitorsResource a owl:ObjectProperty ;
    rdfs:domain prometheus:EnergyMetric ;
    rdfs:range instn:Resource ;
    rdfs:label "monitors resource" ;
    rdfs:comment "The resource that the energy metric estimates." ;
    owl:minCardinality 1 ;
    owl:maxCardinality 1 .

instn:hasAggregationLevel a owl:ObjectProperty ;
    rdfs:label "aggregation level" ;
    rdfs:comment "The level of aggregation applied to the metric." ;
    owl:minCardinality 1 ;
    owl:maxCardinality 1 .

instn:hasService a owl:ObjectProperty ;
    rdfs:domain instn:TargetApplication ;
    rdfs:range instn:Service ;
    rdfs:label "has service" ;
    owl:minCardinality 1 .

instn:exposesMetric a owl:ObjectProperty ;
    rdfs:domain instn:ServiceEndpoint ;
    rdfs:range prometheus:PrometheusMetric ;
    rdfs:label "exposes metric" ;
    owl:minCardinality 1 .

instn:hasEndpointType a owl:ObjectProperty ;
    rdfs:domain instn:ServiceEndpoint ;
    rdfs:range instn:EndpointType ;
    rdfs:label "Has Endpoint Type" ;
    rdfs:comment "The type of service endpoint." ;
    owl:minCardinality 1 ;
    owl:maxCardinality 1 .

instn:metricValue a owl:DatatypeProperty ;
    rdfs:domain prometheus:PrometheusMetric ;
    rdfs:range xsd:float ;
    rdfs:label "Metric Value" ;
    rdfs:comment "The numeric value of the metric at some timestamp." ;
    owl:minCardinality 1 ;
    owl:maxCardinality 1 .

instn:hasName a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "has name" ;
    rdfs:comment "A general-purpose name for instances." ;
    owl:minCardinality 1 ;
    owl:maxCardinality 1 .

instn:reportsMetrics a owl:ObjectProperty ;
    rdfs:domain instn:AnalyticsProvider ;
    rdfs:range instn:EnergyMetric ;
    rdfs:label "reports metrics" ;
    rdfs:comment "Specifies that the analytics provider reports a specific type of metric, specifically EnergyMetric." ;
    owl:minCardinality 1 .